---
import { getCreativeProjects } from '../lib/portfolio-data';

const projects = await getCreativeProjects();
---

<section id="projects" class="relative py-16 md:py-24 lg:py-32 overflow-hidden" aria-labelledby="projects-heading">
  <!-- Background accent -->
  <div
    class="absolute left-0 top-1/3 w-[400px] h-[400px] rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(56,189,248,0.05) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="section-container">
    <!-- Section header -->
    <div class="mb-16">
      <div class="section-label">
        02 / Projects
      </div>
      <h2
        id="projects-heading"
        class="font-display text-4xl sm:text-5xl font-bold mb-4"
        style="font-family: 'Syne', sans-serif; color: #f8fafc;"
      >
        Featured <span class="text-gradient-cyber">Work</span>
      </h2>
      <p class="text-base max-w-lg" style="color: #94a3b8;">
        A curated selection of projects — each one a different challenge, solved with precision and creative engineering.
      </p>
    </div>

    <!-- Project grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, index) => (
        <article class="project-card group" aria-label={project.title}>
          <!-- Card header: number + links -->
          <div class="flex items-start justify-between mb-4">
            <span
              class="font-mono text-xs"
              style="color: #334155;"
            >
              _{String(index + 1).padStart(2, '0')}
            </span>
            <div class="flex gap-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <a
                href={project.githubUrl || '#'}
                aria-label={`View ${project.title} source code`}
                class="w-8 h-8 rounded-lg flex items-center justify-center transition-all duration-200"
                style="border: 1px solid rgba(56,189,248,0.2); color: #94a3b8;"
              >
                <!-- Git icon -->
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/>
                  <path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/>
                  <path d="M12 12v3"/>
                </svg>
              </a>
              <a
                href={project.liveUrl || '#'}
                aria-label={`View ${project.title} live demo`}
                class="w-8 h-8 rounded-lg flex items-center justify-center transition-all duration-200"
                style="border: 1px solid rgba(56,189,248,0.2); color: #94a3b8;"
              >
                <!-- External link icon -->
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Folder icon -->
          <div class="mb-4">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="1.5" style="opacity: 0.8;">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            </svg>
          </div>

          <!-- Title -->
          <h3 class="text-lg font-semibold mb-2 group-hover:transition-colors duration-300"
            style="color: #f8fafc; font-family: 'Syne', sans-serif;"
          >
            {project.title}
          </h3>

          <!-- Description -->
          <p class="text-sm leading-relaxed flex-1" style="color: #94a3b8;">
            {project.summary}
          </p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mt-5">
            {project.stack?.map((tag) => (
              <span class="cyber-tag">{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- View all link -->
    <div class="mt-12 text-center">
      <a href="#" class="btn-cyber">
        <span>View All Projects</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
