---
// Navbar.astro — Fixed navigation bar dengan glassmorphism

const navLinks = [
  { href: '#hero',     label: 'Home',     num: '01' },
  { href: '#projects', label: 'Projects', num: '02' },
  { href: '#skills',   label: 'Skills',   num: '03' },
  { href: '#contact',  label: 'Contact',  num: '04' },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  role="banner"
>
  <nav
    class="section-container flex items-center justify-between h-16"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a
      href="#hero"
      class="flex items-center gap-2 font-mono text-sm font-medium group"
      style="color: #f8fafc;"
      aria-label="Back to top"
    >
      <span class="block transition-colors duration-300 group-hover:text-cyber-500" style="">
        Bayu Mutawakkil<span style="color: #38bdf8;">.dev</span>
      </span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden md:flex items-center gap-1" role="list">
      {navLinks.map(({ href, label, num }) => (
        <li>
          <a
            href={href}
            class="nav-link relative px-4 py-2 rounded-lg font-mono text-xs flex items-center gap-1.5 transition-all duration-300"
            style="color: #94a3b8;"
          >
            <span style="color: rgba(56,189,248,0.5);">{num}</span>
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA + Mobile menu -->
    <div class="flex items-center gap-3">
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex btn-cyber text-xs px-4 py-2"
        style="padding: 0.5rem 1.25rem;"
        aria-label="Download resume PDF"
      >
        <span>Resume</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        class="md:hidden w-9 h-9 flex flex-col items-center justify-center gap-1.5 rounded-lg transition-all duration-300"
        style="border: 1px solid rgba(56,189,248,0.15); color: #94a3b8;"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <span id="bar1" class="w-5 h-px transition-all duration-300" style="background: currentColor;"></span>
        <span id="bar2" class="w-3.5 h-px transition-all duration-300" style="background: currentColor;"></span>
        <span id="bar3" class="w-5 h-px transition-all duration-300" style="background: currentColor;"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu dropdown -->
  <div
    id="mobile-menu"
    class="md:hidden hidden"
    style="background: rgba(10,15,29,0.97); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(56,189,248,0.1);"
    role="menu"
    aria-label="Mobile navigation"
  >
    <ul class="section-container py-4 flex flex-col gap-1" role="list">
      {navLinks.map(({ href, label, num }) => (
        <li>
          <a
            href={href}
            class="flex items-center gap-3 px-4 py-3 rounded-lg font-mono text-sm transition-all duration-300"
            style="color: #94a3b8;"
            role="menuitem"
          >
            <span style="color: rgba(56,189,248,0.5);">{num}</span>
            {label}
          </a>
        </li>
      ))}
      <li class="mt-2 pt-2" style="border-top: 1px solid rgba(56,189,248,0.1);">
        <a
          href="/resume.pdf"
          target="_blank"
          class="flex items-center gap-2 px-4 py-3 rounded-lg font-mono text-sm"
          style="color: #38bdf8;"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download Resume
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  /* Navbar glassmorphism on scroll */
  #navbar.scrolled {
    background: rgba(3, 7, 18, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(56, 189, 248, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  }

  .nav-link:hover {
    color: #f8fafc;
    background: rgba(56, 189, 248, 0.06);
  }

  .nav-link.active {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.08);
  }

  #mobile-menu a:hover {
    color: #f8fafc;
    background: rgba(56, 189, 248, 0.06);
  }
</style>

<script>
  // Scroll-based navbar styling
  const navbar = document.getElementById('navbar')!;
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  // Active section highlighting
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            const href = link.getAttribute('href');
            link.classList.toggle('active', href === `#${entry.target.id}`);
          });
        }
      });
    },
    { threshold: 0.4 }
  );

  sections.forEach((section) => observer.observe(section));

  // Mobile menu toggle
  const menuToggle = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const bar1 = document.getElementById('bar1')!;
  const bar2 = document.getElementById('bar2')!;
  const bar3 = document.getElementById('bar3')!;

  let menuOpen = false;

  menuToggle.addEventListener('click', () => {
    menuOpen = !menuOpen;
    menuToggle.setAttribute('aria-expanded', String(menuOpen));

    if (menuOpen) {
      mobileMenu.classList.remove('hidden');
      bar1.style.transform = 'translateY(6px) rotate(45deg)';
      bar2.style.opacity = '0';
      bar3.style.transform = 'translateY(-6px) rotate(-45deg)';
      bar3.style.width = '20px';
    } else {
      mobileMenu.classList.add('hidden');
      bar1.style.transform = '';
      bar2.style.opacity = '1';
      bar3.style.transform = '';
      bar3.style.width = '';
    }
  });

  // Close mobile menu on link click
  mobileMenu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menuOpen = false;
      mobileMenu.classList.add('hidden');
      menuToggle.setAttribute('aria-expanded', 'false');
      bar1.style.transform = '';
      bar2.style.opacity = '1';
      bar3.style.transform = '';
    });
  });
</script>
