---
import { experience } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';
---
<!-- 04 — EXPERIENCE: Desktop strict accordion (Observer). Mobile vertical list, all open, native scroll -->
<section
  class="experience section-pad relative flex h-auto min-h-screen max-lg:min-h-screen max-lg:h-auto max-lg:overflow-visible flex-col lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden"
  id="experience"
  aria-labelledby="experience-title"
>
  <!-- Header -->
  <div class="shrink-0">
    <SectionHeading number="04 — EXPERIENCE" aside="LEARNING IN PUBLIC" />
    <h2
      id="experience-title"
      class="m-0 mt-[clamp(6px,1.2vh,14px)] font-[var(--display)] text-[clamp(1.8rem,6vw,3.6rem)] font-semibold leading-[0.95] tracking-[-0.05em] text-[#e9f2fc]"
    >
      Learning through<br /><span class="text-[#66819e]">real systems.</span>
    </h2>
  </div>

  <!-- Desktop: horizontal accordion; Mobile: vertical list, all open -->
  <div class="mt-[clamp(12px,2vh,24px)] flex w-full min-h-0 flex-1 flex-col gap-6 max-lg:gap-8 lg:flex-row lg:gap-0 lg:overflow-hidden lg:rounded-2xl lg:border lg:border-white/[0.06] lg:bg-white/[0.015]">
    {experience.map((item, i) => (
      <article
        class:list={[
          'group relative flex min-h-0 min-w-0 flex-col overflow-visible lg:overflow-hidden',
          'rounded-2xl border border-white/[0.08] bg-gradient-to-b from-white/[0.05] to-white/[0.01] backdrop-blur-xl shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] lg:rounded-none lg:border-t lg:border-l-0 lg:border-white/10 lg:first:border-t-0 lg:border-l lg:first:border-l-0',
          'transition-[flex-grow,flex-basis,background-color,opacity] duration-500 ease-in-out',
          // desktop: horizontal accordion (hover/focus)
          'lg:h-full lg:flex-1 lg:basis-0 lg:hover:flex-[3] lg:hover:bg-white/[0.055] lg:focus-within:flex-[3] lg:focus-within:bg-white/[0.055]',
        ]}
        tabindex="0"
        aria-label={`${item.period} — ${item.title}`}
      >
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#4d9fff]/0 to-transparent transition-all duration-700 lg:group-hover:via-[#4d9fff]/40 lg:group-focus-within:via-[#4d9fff]/40"></div>

        <div class="relative flex h-full min-h-0 w-full flex-col overflow-visible p-6 sm:p-7 lg:overflow-hidden lg:p-[clamp(12px,2vh,22px)]">
          {/* Mobile: always visible header + content (Vertical List elegan & bernapas) */}
          <div class="flex w-full items-start justify-between gap-4 lg:hidden">
            <div class="flex min-w-0 flex-col gap-1.5">
              <span class="font-[var(--mono)] text-[10.5px] font-medium tracking-[0.14em] text-[#4d9fff]">{item.period}</span>
              <h3 class="m-0 font-[var(--display)] text-[1.2rem] font-semibold leading-[1.2] tracking-[-0.02em] text-white">{item.title}</h3>
              <p class="m-0 font-[var(--mono)] text-[10px] uppercase tracking-[0.12em] text-[#82d8ed]/90">{item.organization}</p>
            </div>
            <span class="shrink-0 font-[var(--mono)] text-[11px] font-medium text-white/40">0{i + 1}</span>
          </div>
          <div class="mt-4 flex flex-col lg:hidden">
            <p class="m-0 text-[0.88rem] leading-[1.68] text-white/75">{item.detail}</p>
          </div>

          {/* ── Desktop: kondisi normal/menyusut (vertikal) ── */}
          <div class="absolute inset-0 hidden flex-col items-center justify-between p-[clamp(10px,1.8vh,18px)] opacity-100 transition-all duration-500 ease-in-out lg:flex lg:group-hover:pointer-events-none lg:group-hover:opacity-0 lg:group-focus-within:pointer-events-none lg:group-focus-within:opacity-0">
            <span class="font-[var(--mono)] text-[clamp(9px,1vh,11px)] tracking-[0.16em] text-[#4d9fff]">{item.period}</span>
            <h3 class="m-0 rotate-180 font-[var(--display)] text-[clamp(0.95rem,2.2vh,1.35rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-[#e9f2fc] [writing-mode:vertical-rl]">
              {item.title}
            </h3>
            <span class="font-[var(--mono)] text-[10px] text-white/25">0{i + 1}</span>
          </div>

          {/* ── Desktop: kondisi lebar (hover/focus), konten horizontal penuh ── */}
          <div class="pointer-events-none hidden h-full min-h-0 translate-y-2 flex-col opacity-0 transition-all duration-500 delay-150 ease-in-out lg:flex lg:group-hover:pointer-events-auto lg:group-hover:translate-y-0 lg:group-hover:opacity-100 lg:group-hover:delay-300 lg:group-focus-within:pointer-events-auto lg:group-focus-within:translate-y-0 lg:group-focus-within:opacity-100 lg:group-focus-within:delay-300">
            <div class="flex shrink-0 items-center justify-between gap-3">
              <span class="font-[var(--mono)] text-[clamp(9px,1vh,11px)] tracking-[0.16em] text-[#4d9fff]">{item.period}</span>
              <span class="font-[var(--mono)] text-[10px] text-white/30">0{i + 1}</span>
            </div>
            <div class="mt-auto min-h-0 overflow-hidden pb-[clamp(2px,0.6vh,8px)]">
              <h3 class="m-0 font-[var(--display)] text-[clamp(1.15rem,2.8vh,2rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-white [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                {item.title}
              </h3>
              <p class="m-0 mt-[clamp(4px,0.8vh,10px)] font-[var(--mono)] text-[clamp(9px,1vh,11px)] uppercase tracking-[0.12em] text-[#82d8ed]/85 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:1] overflow-hidden">
                {item.organization}
              </p>
              <p class="m-0 mt-[clamp(6px,1.1vh,14px)] max-w-[46ch] text-[clamp(0.72rem,1.2vh,0.95rem)] leading-[1.55] text-white/60 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:3] overflow-hidden">
                {item.detail}
              </p>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
