---
import type { CreativeProfile } from '../lib/portfolio-data';

interface Props {
  profile: CreativeProfile | null;
}

const { profile } = Astro.props;
const name = profile?.name || 'Bayu Mutawakkil';
const role = profile?.role || 'Frontend Developer & UI Engineer';
const bio = profile?.shortBio || 'Crafting performant and visually immersive web experiences — where clean code meets stunning interfaces.';
const socialLinks = profile?.socialLinks || [
  { _key: 'github', platform: 'GitHub', url: 'https://github.com/bayumutawakkil' },
  { _key: 'linkedin', platform: 'LinkedIn', url: 'https://linkedin.com/in/bayumutawakkil' },
];
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden"
  aria-label="Hero section"
>
  <!-- Three.js Canvas -->
  <canvas
    id="hero-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none"
    aria-hidden="true"
  ></canvas>

  <!-- Ambient radial glow -->
  <div
    class="absolute right-0 top-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(56,189,248,0.07) 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Dot grid texture -->
  <div class="absolute inset-0 dot-grid opacity-40 pointer-events-none" aria-hidden="true"></div>

  <!-- Hero content -->
  <div class="section-container relative z-10 pt-28 pb-16 lg:py-0">
    <div class="max-w-2xl">
      <!-- Status badge -->
      <div
        class="inline-flex items-center gap-2 mb-8 cyber-tag animate-[fadeUp_0.6s_ease_forwards]"
        style="animation-delay: 0.1s; opacity: 0;"
      >
        <span
          class="w-2 h-2 rounded-full bg-green-400"
          style="box-shadow: 0 0 8px rgba(74, 222, 128, 0.7); animation: pulseGlow 2s ease-in-out infinite;"
        ></span>
        Available for work
      </div>

      <!-- Greeting -->
      <p
        class="font-mono text-cyber-500 text-sm tracking-widest uppercase mb-4 animate-[fadeUp_0.6s_ease_forwards]"
        style="animation-delay: 0.2s; opacity: 0; color: #38bdf8;"
      >
        &lt; Hello, World! /&gt;
      </p>

      <!-- Name heading -->
      <h1
        class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold leading-none mb-6 animate-[fadeUp_0.6s_ease_forwards]"
        style="animation-delay: 0.35s; opacity: 0; font-family: 'Syne', sans-serif;"
      >
        <span class="text-ice-white" style="color: #f8fafc;">I'm</span>
        <br />
        <span class="text-gradient-cyber">{name}</span>
        <span class="text-blue-muted text-4xl lg:text-5xl" style="color: #94a3b8;">.</span>
      </h1>

      <!-- Role -->
      <div
        class="flex items-center gap-3 mb-6 animate-[fadeUp_0.6s_ease_forwards]"
        style="animation-delay: 0.5s; opacity: 0;"
      >
        <div class="h-px flex-1 max-w-[40px]" style="background: linear-gradient(to right, #38bdf8, transparent);"></div>
        <p
          class="font-mono text-base sm:text-lg"
          style="color: #94a3b8;"
        >
          {role}
        </p>
      </div>

      <!-- Tagline -->
      <p
        class="text-base sm:text-lg leading-relaxed mb-10 max-w-lg animate-[fadeUp_0.6s_ease_forwards]"
        style="animation-delay: 0.65s; opacity: 0; color: #94a3b8;"
      >
        {bio}
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-wrap gap-4 animate-[fadeUp_0.6s_ease_forwards]"
        style="animation-delay: 0.8s; opacity: 0;"
      >
        <a href="#projects" class="btn-cyber btn-cyber-solid">
          <span>View Projects</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a href="#contact" class="btn-cyber">
          <span>Get in Touch</span>
        </a>
      </div>

      <!-- Social links -->
      <div
        class="flex items-center gap-5 mt-10 animate-[fadeUp_0.6s_ease_forwards]"
        style="animation-delay: 0.95s; opacity: 0;"
      >
        <span class="font-mono text-xs tracking-widest uppercase" style="color: #334155;">Find me on</span>
        <div class="flex gap-4">
          {socialLinks.map(({ url, platform }) => (
            <a
              href={url}
              target={url.startsWith('http') ? '_blank' : undefined}
              rel={url.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={platform}
              class="w-9 h-9 rounded-lg flex items-center justify-center font-mono text-sm transition-all duration-300"
              style="border: 1px solid rgba(56,189,248,0.15); color: #94a3b8;"
              onmouseenter="this.style.borderColor='rgba(56,189,248,0.5)';this.style.color='#38bdf8';this.style.boxShadow='0 0 12px rgba(56,189,248,0.25)'"
              onmouseleave="this.style.borderColor='rgba(56,189,248,0.15)';this.style.color='#94a3b8';this.style.boxShadow='none'"
            >
              {platform.slice(0, 1).toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-[fadeIn_1s_ease_1.2s_forwards]"
    style="opacity: 0;"
    aria-hidden="true"
  >
    <span class="font-mono text-xs tracking-widest uppercase" style="color: #334155;">Scroll</span>
    <div
      class="w-px h-12 relative overflow-hidden"
      style="background: rgba(56,189,248,0.15);"
    >
      <div
        class="absolute top-0 w-full"
        style="height: 40%; background: linear-gradient(to bottom, #38bdf8, transparent); animation: scanLine 2s ease-in-out infinite;"
      ></div>
    </div>
  </div>
</section>

<script>
  import * as THREE from 'three';

  // ── Canvas setup ──────────────────────────────────────────────
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (!canvas) throw new Error('Canvas not found');

  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: true,
    alpha: true,
  });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setClearColor(0x000000, 0);

  const scene  = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 100);
  camera.position.set(0, 0, 4.5);

  // ── Mouse tracking ─────────────────────────────────────────────
  const mouse    = { x: 0, y: 0 };
  const targetRot = { x: 0, y: 0 };

  window.addEventListener('mousemove', (e) => {
    mouse.x = (e.clientX / window.innerWidth)  * 2 - 1;
    mouse.y = (e.clientY / window.innerHeight) * 2 - 1;
  });

  // ── Torus Knot (main object) ───────────────────────────────────
  const geometry = new THREE.TorusKnotGeometry(1, 0.32, 180, 24, 2, 3);

  // Wireframe layer (outer glow)
  const wireMat = new THREE.MeshBasicMaterial({
    color: 0x38bdf8,
    wireframe: true,
    transparent: true,
    opacity: 0.12,
  });
  const wireMesh = new THREE.Mesh(geometry, wireMat);
  scene.add(wireMesh);

  // Solid layer with custom shader-like material
  const solidMat = new THREE.MeshPhongMaterial({
    color: 0x0a1628,
    emissive: 0x0ea5e9,
    emissiveIntensity: 0.08,
    shininess: 120,
    transparent: true,
    opacity: 0.7,
    side: THREE.FrontSide,
  });
  const solidMesh = new THREE.Mesh(geometry, solidMat);
  scene.add(solidMesh);

  // ── Particle Field (background stars) ─────────────────────────
  const particleCount = 600;
  const positions = new Float32Array(particleCount * 3);
  for (let i = 0; i < particleCount * 3; i++) {
    positions[i] = (Math.random() - 0.5) * 20;
  }
  const particleGeo = new THREE.BufferGeometry();
  particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

  const particleMat = new THREE.PointsMaterial({
    color: 0x38bdf8,
    size: 0.025,
    transparent: true,
    opacity: 0.45,
    sizeAttenuation: true,
  });
  const particles = new THREE.Points(particleGeo, particleMat);
  scene.add(particles);

  // ── Lighting ───────────────────────────────────────────────────
  const ambientLight = new THREE.AmbientLight(0x0a1628, 1.2);
  scene.add(ambientLight);

  const cyberLight1 = new THREE.PointLight(0x38bdf8, 3, 12);
  cyberLight1.position.set(3, 3, 3);
  scene.add(cyberLight1);

  const cyberLight2 = new THREE.PointLight(0x818cf8, 2, 10);
  cyberLight2.position.set(-3, -2, 2);
  scene.add(cyberLight2);

  // ── Position the 3D object to the right ─────────────────────────
  solidMesh.position.set(2.2, 0, 0);
  wireMesh.position.set(2.2, 0, 0);

  // ── Animation loop ─────────────────────────────────────────────
  const clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);
    const elapsed = clock.getElapsedTime();

    // Smooth mouse-driven rotation
    targetRot.x += (mouse.y * 0.4 - targetRot.x) * 0.05;
    targetRot.y += (mouse.x * 0.6 - targetRot.y) * 0.05;

    // Auto-spin + mouse parallax
    solidMesh.rotation.x = targetRot.x + elapsed * 0.18;
    solidMesh.rotation.y = targetRot.y + elapsed * 0.22;
    wireMesh.rotation.x  = solidMesh.rotation.x;
    wireMesh.rotation.y  = solidMesh.rotation.y;

    // Subtle float
    const floatY = Math.sin(elapsed * 0.7) * 0.12;
    solidMesh.position.y = floatY;
    wireMesh.position.y  = floatY;

    // Particles slow drift
    particles.rotation.y = elapsed * 0.02;
    particles.rotation.x = elapsed * 0.01;

    // Glow pulse on emissive
    solidMat.emissiveIntensity = 0.08 + Math.sin(elapsed * 1.5) * 0.06;

    // Camera subtle parallax
    camera.position.x += (mouse.x * 0.15 - camera.position.x) * 0.02;
    camera.position.y += (-mouse.y * 0.08 - camera.position.y) * 0.02;
    camera.lookAt(2.2, 0, 0);

    renderer.render(scene, camera);
  }

  animate();

  // ── Responsive resize ──────────────────────────────────────────
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  });
</script>
