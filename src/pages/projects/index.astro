---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import ProjectsGallery from '../../components/sections/ProjectsGallery.astro';
import { getOrderedProjects } from '../../data/project-gallery';

const galleryProjects = await getOrderedProjects();
---
<BaseLayout title="Works — Bayu Mutawakkil" description="A selection of systems, experiments, and digital work.">
  <div class="projects-archive-page">
    <Nav />
    <ProjectsGallery projects={galleryProjects} />
  </div>
</BaseLayout>