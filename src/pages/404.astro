---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
---
<BaseLayout title="Page not found — Bayu Mutawakkil" description="The page you are looking for does not exist.">
  <div class="not-found-page">
    <Nav />
    <main class="not-found section-pad">
      <p class="not-found-kicker">ERROR / 404</p>
      <h1 class="not-found-title">Lost in<br /><span>the void.</span></h1>
      <p class="not-found-copy">The page you’re looking for doesn’t exist or has moved. Let’s get you back to familiar ground.</p>
      <div class="not-found-actions">
        <a class="button-primary not-found-cta" href="/">Back home <span>↗</span></a>
        <a class="text-link" href="/projects">Browse works <span>→</span></a>
      </div>
    </main>
  </div>
</BaseLayout>