---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import SelectedWorks from '../components/sections/SelectedWorks.astro';
import Experience from '../components/sections/Experience.astro';
import { profile, capabilities } from '../data/site';
---
<BaseLayout>
  <div class="site-shell" id="top">
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <Nav />
    <main data-fullpage class="relative">
      <!-- Hero: Desktop = stepped/absolute with GSAP Observer; Mobile = stacked editorial scroll -->
      <section
        id="hero"
        data-hero="true"
        aria-labelledby="hero-title"
        class="hero section-pad relative flex h-auto min-h-screen max-lg:min-h-screen max-lg:h-auto max-lg:overflow-visible flex-col lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden"
      >
        <!-- Mobile (max-lg): Gaya sampul majalah editorial bernuansa depth & overlapping.
             Desktop (lg): komposisi stepped absolute (BAYU kiri / MUTAWAKKIL kanan, foto naik dari bawah). -->
        <div class="hero-main relative flex min-h-0 flex-1 flex-col items-center justify-center py-6 max-lg:py-8 lg:block lg:py-0">
          <span class="sr-only" id="hero-title">Bayu Mutawakkil</span>

          <!-- Container magazine layout mobile: BAYU -> Foto menimpa (overlap) -> MUTAWAKKIL di belakang bawah foto -->
          <div class="relative flex w-full flex-col items-center justify-center max-lg:isolate lg:contents">
            <!-- BAYU: Sangat besar, tebal, leading-none, text-center di mobile -->
            <div class="relative z-[1] shrink-0 text-center lg:pointer-events-none lg:absolute lg:inset-x-0 lg:top-1/2 lg:order-none lg:-translate-y-[72%] lg:text-left">
              <span aria-hidden="true" class="hero-title m-0 block px-2 font-[var(--display)] font-bold tracking-[-0.06em] text-[clamp(4.2rem,19vw,7.5rem)] leading-[0.8] text-center [text-shadow:0_10px_40px_rgba(0,0,0,0.45)] max-lg:will-change-[transform,opacity] lg:px-[clamp(8px,2vw,24px)] lg:text-[clamp(4rem,18vw,7rem)] lg:leading-[0.88] lg:self-start lg:text-left">
                <span data-hero-bayu class="inline-block max-lg:!transform-none max-lg:!opacity-100 will-change-transform">BAYU</span>
              </span>
            </div>

            <!-- FOTO glassmorphism: Z-index lebih tinggi (z-[3]), overlap menumpuk teks dengan negative margin (-mt-8 sm:-mt-12) & (-mb-8 sm:-mb-12) -->
            <div
              data-hero-photo
              aria-hidden="true"
              class="relative z-[3] flex w-[85vw] max-w-xs sm:max-w-sm shrink items-center justify-center -mt-7 sm:-mt-10 -mb-8 sm:-mb-12 max-lg:will-change-[transform,opacity] max-lg:!opacity-100 max-lg:!transform-none lg:pointer-events-none lg:absolute lg:inset-x-0 lg:bottom-0 lg:m-0 lg:h-full lg:w-auto lg:max-w-none lg:items-end lg:pb-[clamp(10px,2vh,24px)] lg:opacity-0"
            >
              <div class="relative flex items-center justify-center">
                <!-- Soft glow di belakang foto untuk menambah depth majalah -->
                <div class="pointer-events-none absolute inset-0 -z-10 scale-95 rounded-full bg-gradient-to-t from-[#4d9fff]/20 to-[#82d8ed]/10 blur-2xl max-lg:block lg:hidden"></div>
                <img
                  src="/bayu.png"
                  alt=""
                  class="h-auto w-full max-h-[46vh] select-none rounded-2xl object-contain object-bottom drop-shadow-[0_25px_50px_rgba(0,0,0,0.85)] filter contrast-[1.03] lg:h-[min(68%,600px)] lg:max-h-none lg:max-w-[min(86vw,480px)]"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>

            <!-- MUTAWAKKIL: Di belakang bagian bawah foto dengan z-[1] -->
            <div class="relative z-[1] shrink-0 text-center lg:pointer-events-none lg:absolute lg:inset-x-0 lg:top-1/2 lg:order-none lg:translate-y-[-2%] lg:text-right">
              <span aria-hidden="true" class="hero-title m-0 block px-2 font-[var(--display)] font-bold tracking-[-0.06em] text-[clamp(2.9rem,13.5vw,5.5rem)] leading-[0.8] text-center [text-shadow:0_10px_40px_rgba(0,0,0,0.45)] max-lg:will-change-[transform,opacity] lg:px-[clamp(8px,2vw,24px)] lg:text-[clamp(4rem,18vw,7rem)] lg:leading-[0.88] lg:self-end lg:text-right">
                <span data-hero-mutawakkil class="inline-block max-lg:!transform-none max-lg:!opacity-100 will-change-transform">MUTAWAKKIL</span>
              </span>
            </div>
          </div>
        </div>

        <div class="hero-bottom relative z-[4] mt-auto shrink-0 max-lg:mt-[clamp(16px,6vh,32px)]" data-hero-meta>
          <p class="hero-intro reveal-up max-w-[46ch] max-lg:text-[12px] max-lg:leading-[1.55]">I’m <strong>Bayu Mutawakkil</strong> — an Information Systems student exploring the intersection of software engineering, business processes, and thoughtful digital experiences.</p>
          <div class="hero-actions reveal-up"><a class="button-primary magnetic" href="#work"><span>Explore projects</span><span class="button-arrow">↗</span></a><a class="text-link max-lg:hidden" href="#about">More about me <span>↓</span></a></div>
        </div>
        <div class="hero-index relative z-[4] shrink-0 max-lg:text-[10px] max-lg:hidden" data-hero-meta><span>01 / 05</span><span class="hero-index-line"></span><span>SCROLL</span><span class="scroll-cue">↓</span></div>
      </section>

      <section class="manifesto section-pad flex h-auto min-h-[100svh] flex-col overflow-visible lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden" id="about">
        <div class="section-heading shrink-0"><span class="section-number">01 — THE APPROACH</span><span class="section-aside">A SYSTEMS-THINKING MINDSET</span></div>
        <div class="manifesto-grid flex-1 items-center lg:min-h-0"><h2 class="manifesto-title" data-reveal-text>Technology is not the destination. <span>It is the way we make better things possible.</span></h2><div class="manifesto-copy lg:min-h-0"><span class="eyebrow">A LITTLE CONTEXT</span><p>I study Information Systems at Universitas Andalas, where technology meets people, processes, and organizations. I’m interested in building software that does more than look good: software that solves a real problem and holds up beyond the demo.</p><p>My curiosity moves between backend logic, interface engineering, data, and enterprise systems. I enjoy understanding the whole picture before deciding what to build.</p><a class="inline-link" href="https://github.com/bayumutawakkil" target="_blank" rel="noreferrer">Explore my GitHub <span>↗</span></a></div></div>
      </section>

      <SelectedWorks />

      <!-- 03 — WHAT I BRING: Desktop strict 100dvh with fullpage; Mobile fluid stacked -->
      <section
        id="expertise"
        aria-labelledby="expertise-title"
        class="relative flex h-auto min-h-screen max-lg:min-h-screen max-lg:h-auto max-lg:overflow-visible flex-col overflow-hidden px-[clamp(16px,4.5vw,72px)] py-12 max-lg:py-16 lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:py-[clamp(8px,1.6vh,18px)] lg:overflow-hidden"
      >
        <div class="mx-auto flex h-full max-h-full min-h-0 w-full max-w-[1440px] flex-col gap-8 max-lg:gap-10 lg:flex-row lg:gap-12">
          <!-- Judul: mobile horizontal/atas (tengah, full width); desktop vertikal di kiri -->
          <div class="flex w-full shrink-0 items-center justify-center max-lg:text-center max-lg:mb-2 lg:h-full lg:min-h-0 lg:w-[clamp(52px,16%,170px)] lg:justify-center lg:overflow-hidden">
            <div class="flex items-center gap-3 max-lg:flex-col lg:min-h-0 lg:flex-col lg:gap-[clamp(6px,1vh,14px)]">
              <span class="font-[var(--mono)] text-[11px] tracking-[0.18em] text-[#6f93b5] [writing-mode:horizontal-tb] lg:[writing-mode:vertical-rl] lg:rotate-180">03 / CAPABILITIES</span>
              <h2
                id="expertise-title"
                class="m-0 font-[var(--display)] text-[clamp(2.2rem,8vw,3.2rem)] font-semibold leading-[0.95] tracking-[-0.04em] text-[#e9f2fc] [writing-mode:horizontal-tb] lg:rotate-180 lg:text-[clamp(2.2rem,7.5vh,5.5rem)] lg:leading-[0.86] lg:tracking-[-0.06em] lg:[writing-mode:vertical-rl]"
              >WHAT I BRING</h2>
            </div>
          </div>

          <!-- Grid: mobile stacked/1-col loose with full text readability; desktop 2x2 fluid -->
          <div class="grid h-full max-h-full min-h-0 flex-1 grid-cols-1 gap-5 max-lg:gap-6 sm:grid-cols-2 lg:grid-cols-2 lg:grid-rows-2 lg:gap-8 lg:pr-[clamp(0px,1vw,12px)]">
            {capabilities.map((item, i) => (
              <article
                class:list={[
                  'group relative flex h-auto flex-col justify-between overflow-visible rounded-2xl lg:h-full lg:min-h-0 lg:overflow-hidden lg:rounded-3xl',
                  'border border-white/[0.08] bg-gradient-to-br from-white/[0.08] to-transparent',
                  'p-6 sm:p-7 backdrop-blur-xl shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] lg:p-[clamp(0.75rem,2.2vh,1.6rem)]',
                  'transition-all duration-300 ease-out',
                  'hover:-translate-y-1 hover:border-[#4d9fff]/25 hover:from-white/[0.14] hover:to-white/[0.03]',
                  'hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.1),0_0_0_1px_rgba(77,159,255,0.12),0_0_28px_rgba(77,159,255,0.10),0_14px_30px_-16px_rgba(0,0,0,0.55)]',
                  i % 2 === 1 && 'lg:translate-y-[clamp(4px,1vh,12px)] lg:hover:translate-y-[calc(clamp(4px,1vh,12px)-4px)]',
                ]}
              >
                <div class="pointer-events-none absolute -right-10 -top-10 h-24 w-24 rounded-full bg-[#4d9fff]/0 blur-2xl transition-all duration-300 group-hover:bg-[#4d9fff]/15"></div>

                <div class="flex shrink-0 items-start justify-between gap-1">
                  <span class="font-[var(--mono)] text-[10px] tracking-[0.14em] text-[#4d9fff] font-medium lg:text-[10px]">{item.id}</span>
                  <span class="text-white/40 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[#82d8ed]">↗</span>
                </div>

                <div class="mt-3 min-h-0 flex-1 lg:mt-[clamp(4px,0.8vh,10px)]">
                  <h3 class="m-0 font-[var(--display)] text-[1.15rem] font-semibold leading-[1.2] tracking-[-0.02em] text-white lg:text-[clamp(0.95rem,1.8vh,1.35rem)] lg:line-clamp-2">{item.title}</h3>
                  <p class="m-0 mt-2.5 text-[0.88rem] leading-[1.65] text-white/80 max-lg:line-clamp-none lg:mt-[clamp(3px,0.6vh,8px)] lg:text-[clamp(0.72rem,1.15vh,0.875rem)] lg:leading-[1.45] lg:[display:-webkit-box] lg:[-webkit-box-orient:vertical] lg:[-webkit-line-clamp:2] lg:overflow-hidden">{item.desc}</p>
                </div>

                <div class="mt-5 shrink-0 pt-2 font-[var(--mono)] text-[0.72rem] uppercase tracking-wider text-white/60 max-lg:line-clamp-none lg:mt-auto lg:pt-[clamp(4px,0.8vh,10px)] lg:text-[clamp(0.55rem,0.85vh,0.72rem)] lg:[display:-webkit-box] lg:[-webkit-box-orient:vertical] lg:[-webkit-line-clamp:1] lg:overflow-hidden">{item.tags}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <Experience />

      <section class="principles section-pad flex h-auto min-h-[100svh] flex-col overflow-visible lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden" id="principles">
        <div class="section-heading shrink-0"><span class="section-number">05 — ENGINEERING NOTES</span><span class="section-aside">A FEW THINGS I BELIEVE</span></div>
        <div class="principles-layout flex-1 items-center lg:min-h-0"><div class="principles-title"><span class="eyebrow">WORKING PRINCIPLES</span><h2>Good work<br/>is <span>considered.</span></h2></div><div class="principle-list lg:min-h-0"><div><span>01</span><p><strong>Understand before building.</strong> The best implementation starts with the right problem definition.</p></div><div><span>02</span><p><strong>Clarity is a feature.</strong> A system should be understandable to the people who use and maintain it.</p></div><div><span>03</span><p><strong>Details compound.</strong> Reliability, accessibility, and performance are not finishing touches.</p></div></div></div>
      </section>

      <section class="contact-section section-pad flex h-auto min-h-[100svh] flex-col overflow-visible lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden" id="contact">
        <div class="section-heading shrink-0"><span class="section-number">05 — WHAT'S NEXT</span><span class="section-aside">LET'S MAKE SOMETHING MATTER</span></div>
        <div class="contact-content flex min-h-0 flex-1 flex-col justify-center lg:min-h-0"><span class="eyebrow"><i class="status-dot"></i> OPEN TO COLLABORATION & OPPORTUNITIES</span><h2>Have a problem<br/>worth <span>solving?</span></h2><p>I’m always interested in thoughtful conversations, meaningful projects, and opportunities to learn through building.</p><a class="contact-cta magnetic" href={`mailto:${profile.email}`}><span>Start a conversation</span><b>↗</b></a></div>
        <div class="contact-footer">
          <div class="footer-bottom"><span>© {new Date().getFullYear()} BAYU MUTAWAKKIL</span><span>DESIGN & ENGINEERING</span></div>
          <div class="contact-links shrink-0"><a href={profile.github} target="_blank" rel="noreferrer">GITHUB <span>↗</span></a><a href={profile.linkedin} target="_blank" rel="noreferrer">LINKEDIN <span>↗</span></a><a href={profile.instagram} target="_blank" rel="noreferrer">INSTAGRAM <span>↗</span></a><a href={`mailto:${profile.email}`}>EMAIL <span>↗</span></a></div>
        </div>
      </section>
    </main>
    <div class="cursor-glow" data-cursor-glow></div>
  </div>
</BaseLayout>
