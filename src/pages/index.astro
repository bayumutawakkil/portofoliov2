---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import SelectedWorks from '../components/sections/SelectedWorks.astro';
import Experience from '../components/sections/Experience.astro';
import { profile, capabilities } from '../data/site';
---
<BaseLayout>
  <div class="site-shell" id="top">
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <Nav />
    <main data-fullpage class="relative">
      <!-- Hero stepped: teks BAYU/MUTAWAKKIL -> (scroll 1) keluar + foto naik -> (scroll 2) ke section 2 -->
      <section
        id="hero"
        data-hero="true"
        aria-labelledby="hero-title"
        class="hero section-pad relative h-[calc(100dvh-var(--nav-h))] max-h-[calc(100dvh-var(--nav-h))] overflow-hidden flex flex-col min-h-0"
      >
        <div class="hero-main relative flex min-h-0 flex-1 items-center justify-center">
          <!-- Layer teks: BAYU kiri, MUTAWAKKIL kanan (flex), absolut/stack agar bebas dianimasikan -->
          <h1
            id="hero-title"
            class="hero-title pointer-events-none absolute inset-x-0 top-1/2 z-[2] m-0 flex w-full -translate-y-1/2 flex-col gap-[clamp(2px,1vh,10px)] px-[clamp(8px,2vw,24px)] leading-[0.88]"
          >
            <span class="block self-start overflow-visible text-left">
              <span data-hero-bayu class="inline-block will-change-transform [text-shadow:0_10px_40px_rgba(0,0,0,0.35)]">BAYU</span>
            </span>
            <span class="block self-end overflow-visible text-right">
              <span data-hero-mutawakkil class="inline-block will-change-transform [text-shadow:0_10px_40px_rgba(0,0,0,0.35)]">MUTAWAKKIL</span>
            </span>
          </h1>

          <!-- Layer foto: awal tersembunyi di bawah layar (GSAP set yPercent:115, autoAlpha:0) -->
          <div
            data-hero-photo
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 bottom-0 z-[3] flex h-full items-end justify-center pb-[clamp(10px,2vh,24px)] opacity-0 will-change-transform"
          >
            <!-- Bingkai estetik (glassmorphism) -->
            <div class="rounded-2xl border-2 border-white/15 bg-white/[0.06] p-2 shadow-[0_20px_60px_-12px_rgba(0,0,0,0.55),0_0_0_1px_rgba(130,216,237,0.08)] backdrop-blur-md">
              <img
                src="/bayu.jpg"
                alt=""
                class="h-[min(68%,600px)] w-auto max-w-[min(86vw,480px)] select-none rounded-xl object-contain object-bottom"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <div class="hero-bottom relative z-[4] mt-auto shrink-0" data-hero-meta>
          <p class="hero-intro reveal-up max-w-[46ch]">I’m <strong>Bayu Mutawakkil</strong> — an Information Systems student exploring the intersection of software engineering, business processes, and thoughtful digital experiences.</p>
          <div class="hero-actions reveal-up"><a class="button-primary magnetic" href="#work"><span>Explore projects</span><span class="button-arrow">↗</span></a><a class="text-link" href="#about">More about me <span>↓</span></a></div>
        </div>
        <div class="hero-index relative z-[4] shrink-0" data-hero-meta><span>01 / 05</span><span class="hero-index-line"></span><span>SCROLL TO EXPLORE</span><span class="scroll-cue">↓</span></div>
      </section>

      <section class="manifesto section-pad h-[calc(100dvh-var(--nav-h))] max-h-[calc(100dvh-var(--nav-h))] overflow-hidden flex flex-col min-h-0" id="about">
        <div class="section-heading shrink-0"><span class="section-number">01 — THE APPROACH</span><span class="section-aside">A SYSTEMS-THINKING MINDSET</span></div>
        <div class="manifesto-grid min-h-0 flex-1 items-center"><h2 class="manifesto-title" data-reveal-text>Technology is not the destination. <span>It is the way we make better things possible.</span></h2><div class="manifesto-copy min-h-0"><span class="eyebrow">A LITTLE CONTEXT</span><p>I study Information Systems at Universitas Andalas, where technology meets people, processes, and organizations. I’m interested in building software that does more than look good: software that solves a real problem and holds up beyond the demo.</p><p>My curiosity moves between backend logic, interface engineering, data, and enterprise systems. I enjoy understanding the whole picture before deciding what to build.</p><a class="inline-link" href="https://github.com/bayumutawakkil" target="_blank" rel="noreferrer">Explore my GitHub <span>↗</span></a></div></div>
      </section>

      <SelectedWorks />

      <!-- 03 — WHAT I BRING: strict, fluid (h-full/min-h-0/max-h-full + clamp vh) — tidak ada overflow -->
      <section
        id="expertise"
        aria-labelledby="expertise-title"
        class="relative h-[calc(100dvh-var(--nav-h))] max-h-[calc(100dvh-var(--nav-h))] min-h-0 overflow-hidden px-[clamp(16px,4.5vw,72px)] py-[clamp(8px,1.6vh,18px)]"
      >
        <div class="mx-auto flex h-full max-h-full min-h-0 w-full max-w-[1440px] gap-10 lg:gap-12 max-md:flex-col">
          <!-- Kiri ~18%: judul vertikal fluid (vh), dibatasi h-full/min-h-0 agar tak terpotong/keluar -->
          <div class="flex h-full min-h-0 w-[clamp(52px,16%,170px)] shrink-0 items-center justify-center overflow-hidden max-md:h-auto max-md:w-full max-md:justify-start">
            <div class="flex min-h-0 items-center gap-[clamp(6px,1vh,14px)] max-md:flex-row md:flex-col">
              <span class="font-[var(--mono)] text-[10px] tracking-[0.18em] text-[#6f93b5] [writing-mode:horizontal-tb] md:[writing-mode:vertical-rl] md:rotate-180">03 / CAPABILITIES</span>
              <h2
                id="expertise-title"
                class="m-0 rotate-180 font-[var(--display)] text-[clamp(2.2rem,7.5vh,5.5rem)] font-semibold leading-[0.86] tracking-[-0.06em] text-[#e9f2fc] [writing-mode:vertical-rl] max-md:rotate-0 max-md:text-[clamp(26px,7vw,36px)] max-md:[writing-mode:horizontal-tb]"
              >WHAT I BRING</h2>
            </div>
          </div>

          <!-- Kanan: grid 2x2 terkunci tinggi (h-full/min-h-0/max-h-full), fluid gap -->
          <div class="grid h-full max-h-full min-h-0 flex-1 grid-cols-2 grid-rows-2 gap-4 md:gap-6 lg:gap-8 md:pr-[clamp(0px,1vw,12px)]">
            {capabilities.map((item, i) => (
              <article
                class:list={[
                  // Premium glass/depth dipertahankan; tinggi kartu terkunci + fluid padding
                  'group relative flex h-full min-h-0 flex-col justify-between overflow-hidden rounded-3xl',
                  'border border-white/[0.05] bg-gradient-to-br from-white/[0.08] to-transparent',
                  'p-[clamp(0.75rem,2.2vh,1.6rem)] backdrop-blur-xl shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]',
                  'transition-all duration-300 ease-out',
                  'hover:-translate-y-1 hover:border-[#4d9fff]/25 hover:from-white/[0.14] hover:to-white/[0.03]',
                  'hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.1),0_0_0_1px_rgba(77,159,255,0.12),0_0_28px_rgba(77,159,255,0.10),0_14px_30px_-16px_rgba(0,0,0,0.55)]',
                  // stagger dikurangi (vh) agar aman dalam overflow-hidden
                  i % 2 === 1 && 'md:translate-y-[clamp(4px,1vh,12px)] md:hover:translate-y-[calc(clamp(4px,1vh,12px)-4px)]',
                ]}
              >
                <div class="pointer-events-none absolute -right-10 -top-10 h-24 w-24 rounded-full bg-[#4d9fff]/0 blur-2xl transition-all duration-300 group-hover:bg-[#4d9fff]/15"></div>

                <div class="flex shrink-0 items-start justify-between gap-2">
                  <span class="font-[var(--mono)] text-[10px] tracking-[0.14em] text-[#4d9fff]/90">{item.id}</span>
                  <span class="text-white/30 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[#82d8ed]">↗</span>
                </div>

                <div class="mt-[clamp(4px,0.8vh,10px)] min-h-0 flex-1 overflow-hidden">
                  <h3 class="m-0 font-[var(--display)] text-[clamp(0.95rem,1.8vh,1.35rem)] font-semibold leading-[1.08] tracking-[-0.03em] text-white">{item.title}</h3>
                  <p class="m-0 mt-[clamp(3px,0.6vh,8px)] text-[clamp(0.72rem,1.15vh,0.875rem)] leading-[1.45] text-white/60 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">{item.desc}</p>
                </div>

                <div class="mt-auto shrink-0 pt-[clamp(4px,0.8vh,10px)] font-[var(--mono)] text-[clamp(0.55rem,0.85vh,0.72rem)] uppercase tracking-widest text-white/40 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:1] overflow-hidden">{item.tags}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <Experience />

      <section class="principles section-pad h-[calc(100dvh-var(--nav-h))] max-h-[calc(100dvh-var(--nav-h))] overflow-hidden flex flex-col min-h-0" id="principles">
        <div class="section-heading shrink-0"><span class="section-number">04 — ENGINEERING NOTES</span><span class="section-aside">A FEW THINGS I BELIEVE</span></div>
        <div class="principles-layout min-h-0 flex-1 items-center"><div class="principles-title"><span class="eyebrow">WORKING PRINCIPLES</span><h2>Good work<br/>is <span>considered.</span></h2></div><div class="principle-list min-h-0"><div><span>01</span><p><strong>Understand before building.</strong> The best implementation starts with the right problem definition.</p></div><div><span>02</span><p><strong>Clarity is a feature.</strong> A system should be understandable to the people who use and maintain it.</p></div><div><span>03</span><p><strong>Details compound.</strong> Reliability, accessibility, and performance are not finishing touches.</p></div></div></div>
      </section>

      <section class="contact-section section-pad h-[calc(100dvh-var(--nav-h))] max-h-[calc(100dvh-var(--nav-h))] overflow-hidden flex flex-col min-h-0" id="contact">
        <div class="section-heading shrink-0"><span class="section-number">05 — WHAT'S NEXT</span><span class="section-aside">LET'S MAKE SOMETHING MATTER</span></div>
        <div class="contact-content flex-1 min-h-0 flex flex-col justify-center"><span class="eyebrow"><i class="status-dot"></i> OPEN TO COLLABORATION & OPPORTUNITIES</span><h2>Have a problem<br/>worth <span>solving?</span></h2><p>I’m always interested in thoughtful conversations, meaningful projects, and opportunities to learn through building.</p><a class="contact-cta magnetic" href={`mailto:${profile.email}`}><span>Start a conversation</span><b>↗</b></a></div>
        <div class="contact-footer">
          <div class="footer-bottom"><span>© {new Date().getFullYear()} BAYU MUTAWAKKIL</span><span>DESIGN & ENGINEERING</span></div>
          <div class="contact-links shrink-0"><a href={profile.github} target="_blank" rel="noreferrer">GITHUB <span>↗</span></a><a href={profile.linkedin} target="_blank" rel="noreferrer">LINKEDIN <span>↗</span></a><a href={profile.instagram} target="_blank" rel="noreferrer">INSTAGRAM <span>↗</span></a><a href={`mailto:${profile.email}`}>EMAIL <span>↗</span></a></div>
        </div>
      </section>
    </main>
    <div class="cursor-glow" data-cursor-glow></div>
  </div>
</BaseLayout>
