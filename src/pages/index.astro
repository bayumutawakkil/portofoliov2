  </div>
  <script>
    document.querySelectorAll<HTMLElement>('.cap-card').forEach((c) => {
      let rafId = 0;
      c.addEventListener('pointermove', (e) => {
        if (rafId) return;
        const x = e.clientX;
        const y = e.clientY;
        rafId = requestAnimationFrame(() => {
          rafId = 0;
          const r = c.getBoundingClientRect();
          c.style.setProperty('--mx', `${x - r.left}px`);
          c.style.setProperty('--my', `${y - r.top}px`);
        });
      }, { passive: true });
    });
  </script>
</BaseLayout>
