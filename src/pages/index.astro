---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { Button } from '../components/ui/button';
import { Badge } from '../components/ui/badge';
import {
  HeroExploreButton,
  PortfolioDock,
  AvailabilityBadge,
  ContactActions,
  ProjectTilt,
  ShimmerLine,
  EdgeProgressiveBlur,
} from '../components/PortfolioUX';
import { profile, capabilities, experience } from '../data/site';
import { galleryProjects } from '../data/project-gallery';
---
<BaseLayout>
  <div class="site-shell" id="top">
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <Nav />
    <!-- 3D Laptop Canvas Container (cross-section interactive 3D model, positioned behind content) -->
    <div id="laptop-scene-container" class="pointer-events-none fixed inset-0 z-[1] overflow-hidden opacity-85 transition-opacity duration-700" aria-hidden="true">
      <canvas id="laptop-canvas" class="h-full w-full block pointer-events-none"></canvas>
    </div>
    <main data-fullpage class="relative z-[2]">
      <!-- Hero: Desktop = stepped/absolute with GSAP Observer; Mobile = stacked editorial scroll -->
      <section
        id="hero"
        data-hero="true"
        aria-labelledby="hero-title"
        class="hero section-pad relative flex h-auto min-h-screen max-lg:min-h-screen max-lg:h-auto max-lg:overflow-visible flex-col lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden"
      >
        <!-- Mobile (max-lg): Gaya sampul majalah editorial bernuansa depth & overlapping.
             Desktop (lg): komposisi stepped absolute (BAYU kiri / MUTAWAKKIL kanan, foto naik dari bawah). -->
        <div class="hero-main relative flex min-h-0 flex-1 flex-col items-center justify-center py-6 max-lg:py-8 lg:block lg:py-0">
          <span class="sr-only" id="hero-title">Bayu Mutawakkil</span>

          <!-- Container magazine layout mobile: BAYU -> Foto menimpa (overlap) -> MUTAWAKKIL di belakang bawah foto -->
          <div class="relative max-lg:flex max-lg:flex-col max-lg:justify-center max-lg:items-center max-lg:isolate lg:contents">
            <!-- BAYU: Sangat besar, tebal, leading-none, text-center di mobile -->
            <div class="relative z-[1] shrink-0 text-center lg:pointer-events-none lg:absolute lg:inset-x-0 lg:top-1/2 lg:order-none lg:-translate-y-[72%] lg:text-left lg:ml-[10vw] max-lg:-mb-6">
              <span aria-hidden="true" class="hero-title m-0 block px-2 font-[var(--display)] font-bold tracking-[-0.06em] text-[clamp(5rem,20vw,8rem)] leading-none text-center [text-shadow:0_10px_40px_rgba(0,0,0,0.45)] max-lg:will-change-[transform,opacity] lg:px-[clamp(8px,2vw,24px)] lg:text-[clamp(4rem,20vw,8rem)] lg:leading-none lg:self-start lg:text-left">
                <span data-hero-bayu class="inline-block max-lg:!transform-none max-lg:!opacity-100 will-change-transform">BAYU</span>
              </span>
            </div>

            <!-- FOTO glassmorphism: Z-index lebih tinggi (z-[3]), overlap menumpuk teks dengan negative margin (-mt-8 sm:-mt-12) & (-mb-8 sm:-mb-12) -->
            <div
              data-hero-photo
              aria-hidden="true"
              class="relative z-[3] flex left-1/2 -translate-x-1/2 w-full max-w-[24rem] shrink items-center justify-center -mt-7 sm:-mt-10 -mb-8 sm:-mb-12 max-w-full max-lg:max-w-[24rem] lg:pointer-events-none lg:absolute lg:bottom-0 lg:m-0 lg:h-full lg:w-auto lg:items-end lg:pb-[clamp(10px,2vh,24px)] lg:opacity-0"
            >
              <div class="relative flex items-center justify-center">
                <!-- Soft glow di belakang foto untuk menambah depth majalah -->
                <div class="hero-aura" aria-hidden="true"></div>
                <img
                  src="/bayu.png"
                  alt=""
                  class="h-auto w-full max-h-[46vh] select-none rounded-2xl object-contain object-bottom drop-shadow-[0_25px_50px_rgba(0,0,0,0.85)] filter contrast-[1.03] lg:h-[min(68%,600px)] lg:max-h-none lg:max-w-[24rem]"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>

            <!-- MUTAWAKKIL: Di belakang bagian bawah foto dengan z-[1] -->
            <div class="relative z-[1] shrink-0 text-center lg:pointer-events-none lg:absolute lg:inset-x-0 lg:top-1/2 lg:order-none lg:translate-y-[-2%] lg:text-right lg:mr-[18vw] max-lg:-mt-6">
              <span aria-hidden="true" class="hero-title m-0 block px-2 font-[var(--display)] font-bold tracking-[-0.06em] text-[clamp(5rem,20vw,8rem)] leading-none text-center [text-shadow:0_10px_40px_rgba(0,0,0,0.45)] max-lg:will-change-[transform,opacity] lg:px-[clamp(8px,2vw,24px)] lg:text-[clamp(4rem,20vw,8rem)] lg:leading-none lg:self-end lg:text-right">
                <span data-hero-mutawakkil class="inline-block max-lg:!transform-none max-lg:!opacity-100 will-change-transform">MUTAWAKKIL</span>
              </span>
            </div>
          </div>
        </div>

        <div class="hero-bottom relative z-[4] mt-auto shrink-0 max-lg:mt-[clamp(16px,6vh,32px)]" data-hero-meta>
          <p class="hero-intro reveal-up max-w-[46ch] max-lg:text-[12px] max-lg:leading-[1.55]">I’m <strong>Bayu Mutawakkil</strong> — an Information Systems student exploring the intersection of software engineering, business processes, and thoughtful digital experiences.</p>
          <div class="hero-actions reveal-up">
            <HeroExploreButton client:load />
            <a class="text-link max-lg:hidden" href="#about">More about me <span>↓</span></a>
          </div>
        </div>
        <div class="hero-index relative z-[4] shrink-0 max-lg:text-[10px] max-lg:hidden" data-hero-meta><span>01 / 06</span><span class="hero-index-line"></span><span>SCROLL</span><span class="scroll-cue">↓</span></div>
      </section>

      <section class="manifesto section-pad flex h-auto min-h-[100svh] flex-col overflow-visible lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden" id="about">
        <div class="section-heading shrink-0"><span class="section-number">01 — THE APPROACH</span><span class="section-aside">A SYSTEMS-THINKING MINDSET</span></div>
        <div class="manifesto-grid flex-1 items-center lg:min-h-0"><h2 class="manifesto-title" data-reveal-text>Technology is not the destination. <span><ShimmerLine client:visible text="It is the way we make better things possible." /></span></h2><div class="manifesto-copy lg:min-h-0"><span class="eyebrow">A LITTLE CONTEXT</span><p>I study Information Systems at Universitas Andalas, where technology meets people, processes, and organizations. I’m interested in building software that does more than look good: software that solves a real problem and holds up beyond the demo.</p><p>My curiosity moves between backend logic, interface engineering, data, and enterprise systems. I enjoy understanding the whole picture before deciding what to build.</p><a class="inline-link" href="https://github.com/bayumutawakkil" target="_blank" rel="noreferrer">Explore my GitHub <span>↗</span></a></div></div>
      </section>

      <!-- Desktop: strict 100dvh dengan fullpage/Observer. Mobile: fluid, stacked, native scroll. -->
      <section
        class="work-section section-pad relative flex h-auto min-h-screen max-lg:min-h-screen max-lg:h-auto max-lg:overflow-visible flex-col lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden [will-change:transform]"
        id="work"
        aria-labelledby="work-title"
      >
        <!-- Section label stays at the top-left, matching the other section headers. -->
        <div class="work-label pointer-events-none absolute left-[clamp(24px,7.1vw,112px)] z-[51]">
          <span class="section-number block">02 — SELECTED PROJECTS</span>
        </div>

        <!-- On desktop, the title is anchored to the left and centered vertically above the slider. -->
        <div class="pointer-events-none relative z-[60] shrink-0 pt-2 text-left lg:absolute lg:left-[clamp(24px,7.1vw,112px)] lg:top-1/2 lg:-translate-y-1/2 lg:pt-0">
          <h2 id="work-title" class="m-0 mt-1 font-[var(--display)] text-[clamp(2rem,9vw,3.25rem)] font-semibold leading-[0.86] tracking-[-0.06em] text-white [text-shadow:0_8px_28px_rgba(0,0,0,0.55),0_2px_8px_rgba(77,159,255,0.18)] lg:mt-2 lg:text-[clamp(56px,11vw,180px)] lg:leading-[0.82] lg:tracking-[-0.07em] lg:text-white">Projects</h2>
        </div>

        <!-- Slider: flex-1 + min-h-0 agar muat 100dvh; swipe horizontal untuk geser proyek -->
        <div class="works-stage relative flex min-h-0 w-full flex-1 items-center" data-drag-gallery role="region" aria-roledescription="carousel" aria-label="Selected projects" tabindex="0">
          <div class="works-stage-top"><span data-gallery-progress aria-live="polite" aria-atomic="true">01 / {String(galleryProjects.length).padStart(2, '0')}</span></div>
          <div class="project-list" data-gallery-track>
            {galleryProjects.map((project, index) => (
              <article class={`project-card project-${project.accent}`} data-project-card data-category={project.category} data-gallery-card data-index={index}>
                <a class="project-card-link" href={`/projects/${project.slug}`} aria-label={`Read case study: ${project.title}`}>
                  <ProjectTilt client:visible>
                    <div class="project-visual">
                      <img src={project.image} alt="" loading="lazy" decoding="async" fetchpriority="low" style={`object-position:${project.position}`} />
                      <div class="project-visual-wash"></div>
                      <div class="visual-top"><span>CASE STUDY / {String(index + 1).padStart(2, '0')}</span><span>{project.year}</span></div>
                      <span class="visual-watermark">{String(index + 1).padStart(2, '0')}</span>
                      <span class="visual-open">OPEN PROJECT <b>↗</b></span>
                    </div>
                  </ProjectTilt>
                  <div class="project-info">
                    <div class="project-meta"><span>{project.category}</span><span>{project.year}</span></div>
                    <div class="project-title-row"><h3>{project.title}</h3><span class="project-link" aria-hidden="true">↗</span></div>
                  </div>
                </a>
              </article>
            ))}
          </div>
          <Button variant="outline" size="icon" className="works-nav works-nav-prev rounded-full border-white/15 bg-white/[0.04] text-foreground hover:bg-white/10" type="button" data-gallery-prev aria-label="Previous project">←</Button>
          <Button variant="outline" size="icon" className="works-nav works-nav-next rounded-full border-white/15 bg-white/[0.04] text-foreground hover:bg-white/10" type="button" data-gallery-next aria-label="Next project">→</Button>
        </div>

        <div class="work-foot z-[6] shrink-0 pt-[clamp(6px,1.2vh,14px)]"><span>2023 — 2026</span><a href="https://github.com/bayumutawakkil" target="_blank" rel="noreferrer">VIEW ALL PROJECTS <span>↗</span></a></div>
      </section>

      <!-- 03 — WHAT I BRING: Desktop strict 100dvh with fullpage; Mobile fluid stacked -->
      <section
        id="expertise"
        aria-labelledby="expertise-title"
        class="relative flex h-auto min-h-screen max-lg:min-h-screen max-lg:h-auto max-lg:overflow-visible flex-col overflow-hidden px-[clamp(16px,4.5vw,72px)] py-12 max-lg:py-16 lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:py-[clamp(8px,1.6vh,18px)] lg:overflow-hidden"
      >
        <div class="mx-auto flex h-auto max-h-full min-h-0 w-full max-w-[1060px] flex-col gap-6 max-lg:gap-8 lg:my-auto lg:flex-row lg:items-center lg:gap-10 lg:pb-12">
          <!-- Judul: mobile horizontal/atas (tengah, full width); desktop vertikal di kiri -->
          <div class="flex w-full shrink-0 items-center justify-center max-lg:text-center max-lg:mb-2 lg:h-auto lg:min-h-0 lg:w-[clamp(48px,14%,130px)] lg:justify-center lg:overflow-hidden">
            <div class="flex items-center gap-3 max-lg:flex-col lg:min-h-0 lg:flex-col lg:gap-[clamp(6px,1vh,14px)]">
              <span class="section-number [writing-mode:horizontal-tb] lg:[writing-mode:vertical-rl] lg:rotate-180">03 — CAPABILITIES</span>
              <h2
                id="expertise-title"
                class="m-0 font-[var(--display)] text-[clamp(2.2rem,8vw,3.2rem)] font-semibold leading-[0.95] tracking-[-0.04em] text-[#e9f2fc] [writing-mode:horizontal-tb] lg:rotate-180 lg:text-[clamp(2.2rem,7vh,5rem)] lg:leading-[0.86] lg:tracking-[-0.06em] lg:[writing-mode:vertical-rl]"
              >WHAT I BRING</h2>
            </div>
          </div>

          <!-- Grid: mobile stacked/1-col loose with full text readability; desktop 2x2 compact -->
          <div class="grid h-auto max-h-full min-h-0 flex-1 grid-cols-1 gap-4 max-lg:gap-6 sm:grid-cols-2 lg:grid-cols-2 lg:grid-rows-[repeat(2,minmax(175px,215px))] lg:content-center lg:gap-5 lg:pr-[clamp(0px,1vw,8px)]">
            {capabilities.map((item, i) => (
              <article
                class:list={[
                  'cap-card group relative flex h-auto flex-col justify-between overflow-visible rounded-2xl lg:h-full lg:min-h-0 lg:overflow-hidden lg:rounded-3xl',
                  'border border-white/[0.08] bg-gradient-to-br from-white/[0.08] to-transparent',
                  'p-5 sm:p-6 backdrop-blur-sm bg-[rgba(4,11,26,0.55)] shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] lg:p-[clamp(0.6rem,1.8vh,1.2rem)]',
                  'transition-all duration-300 ease-out',
                  'hover:-translate-y-1 hover:border-[#4d9fff]/25 hover:from-white/[0.14] hover:to-white/[0.03]',
                  'hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.1),0_0_0_1px_rgba(77,159,255,0.12),0_0_28px_rgba(77,159,255,0.10),0_14px_30px_-16px_rgba(0,0,0,0.55)]',
                  i % 2 === 1 && 'lg:translate-y-[clamp(4px,1vh,12px)] lg:hover:translate-y-[calc(clamp(4px,1vh,12px)-4px)]',
                ]}
              >
                <div class="pointer-events-none absolute -right-10 -top-10 h-24 w-24 rounded-full bg-[#4d9fff]/0 blur-2xl transition-all duration-300 group-hover:bg-[#4d9fff]/15"></div>

                <div class="flex shrink-0 items-start justify-between gap-1">
                  <Badge variant="outline" className="cap-id border-[#4d9fff]/30 bg-[#4d9fff]/10 font-[var(--mono)] text-[10px] tracking-[0.14em] text-[#4d9fff]">{item.id}</Badge>
                  <span class="text-white/40 transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[#82d8ed]">↗</span>
                </div>

                <div class="mt-3 min-h-0 flex-1 lg:mt-[clamp(4px,0.8vh,10px)]">
                  <h3 class="m-0 font-[var(--display)] text-[1.15rem] font-semibold leading-[1.2] tracking-[-0.02em] text-white lg:text-[clamp(0.95rem,1.8vh,1.35rem)] lg:line-clamp-2">{item.title}</h3>
                  <p class="m-0 mt-2.5 text-[0.88rem] leading-[1.65] text-white/80 max-lg:line-clamp-none lg:mt-[clamp(3px,0.6vh,8px)] lg:text-[clamp(0.72rem,1.15vh,0.875rem)] lg:leading-[1.45] lg:[display:-webkit-box] lg:[-webkit-box-orient:vertical] lg:[-webkit-line-clamp:2] lg:overflow-hidden">{item.desc}</p>
                </div>

                <div class="mt-5 shrink-0 pt-2 font-[var(--mono)] text-[0.72rem] uppercase tracking-wider text-white/60 max-lg:line-clamp-none lg:mt-auto lg:pt-[clamp(4px,0.8vh,10px)] lg:text-[clamp(0.55rem,0.85vh,0.72rem)] lg:[display:-webkit-box] lg:[-webkit-box-orient:vertical] lg:[-webkit-line-clamp:1] lg:overflow-hidden">{item.tags}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 04 — EXPERIENCE: Desktop strict accordion (Observer). Mobile vertical list, all open, native scroll -->
      <section
        class="experience section-pad relative flex h-auto min-h-screen max-lg:min-h-screen max-lg:h-auto max-lg:overflow-visible flex-col lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden"
        id="experience"
        aria-labelledby="experience-title"
      >
        <!-- Header -->
        <div class="shrink-0">
          <SectionHeading number="04 — EXPERIENCE" aside="LEARNING IN PUBLIC" />
          <h2
            id="experience-title"
            class="m-0 mt-[clamp(6px,1.2vh,14px)] font-[var(--display)] text-[clamp(1.8rem,6vw,3.6rem)] font-semibold leading-[0.95] tracking-[-0.05em] text-[#e9f2fc]"
          >
            Learning through<br /><span class="text-[#66819e]">real systems.</span>
          </h2>
        </div>

        <!-- Desktop: horizontal accordion; Mobile: vertical list, all open -->
        <div class="mt-[clamp(12px,2vh,24px)] flex w-full min-h-0 flex-1 flex-col gap-6 max-lg:gap-8 lg:mb-10 lg:max-h-[clamp(300px,46vh,420px)] lg:flex-row lg:gap-0 lg:overflow-hidden lg:rounded-2xl lg:border lg:border-white/[0.06] lg:bg-white/[0.015]">
          {experience.map((item, i) => (
            <article
              class:list={[
                'group relative flex min-h-0 min-w-0 flex-col overflow-visible lg:overflow-hidden',
                'rounded-2xl border border-white/[0.08] bg-gradient-to-b from-white/[0.05] to-white/[0.01] backdrop-blur-sm bg-[rgba(4,11,26,0.55)] shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] lg:rounded-none lg:border-t lg:border-l-0 lg:border-white/10 lg:first:border-t-0 lg:border-l lg:first:border-l-0',
                'transition-[flex-grow,flex-basis,background-color,opacity] duration-500 ease-in-out',
                // desktop: horizontal accordion (hover/focus)
                'lg:h-full lg:flex-1 lg:basis-0 lg:hover:flex-[3] lg:hover:bg-white/[0.055] lg:focus-within:flex-[3] lg:focus-within:bg-white/[0.055]',
              ]}
              tabindex="0"
              aria-label={`${item.period} — ${item.title}`}
            >
              <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#4d9fff]/0 to-transparent transition-all duration-700 lg:group-hover:via-[#4d9fff]/40 lg:group-focus-within:via-[#4d9fff]/40"></div>

              <div class="relative flex h-full min-h-0 w-full flex-col overflow-visible p-6 sm:p-7 lg:overflow-hidden lg:p-[clamp(12px,2vh,22px)]">
                {/* Mobile: always visible header + content (Vertical List elegan & bernapas) */}
                <div class="flex w-full items-start justify-between gap-4 lg:hidden">
                  <div class="flex min-w-0 flex-col gap-1.5">
                    <span class="font-[var(--mono)] text-[10.5px] font-medium tracking-[0.14em] text-[#4d9fff]">{item.period}</span>
                    <h3 class="m-0 font-[var(--display)] text-[1.2rem] font-semibold leading-[1.2] tracking-[-0.02em] text-white">{item.title}</h3>
                    <p class="m-0 font-[var(--mono)] text-[10px] uppercase tracking-[0.12em] text-[#82d8ed]/90">{item.organization}</p>
                  </div>
                  <span class="shrink-0 font-[var(--mono)] text-[11px] font-medium text-white/40">0{i + 1}</span>
                </div>
                <div class="mt-4 flex flex-col lg:hidden">
                  <p class="m-0 text-[0.88rem] leading-[1.68] text-white/75">{item.detail}</p>
                </div>

                {/* ── Desktop: kondisi normal/menyusut (vertikal) ── */}
                <div class="absolute inset-0 hidden flex-col items-center justify-between p-[clamp(10px,1.8vh,18px)] opacity-100 transition-all duration-500 ease-in-out lg:flex lg:group-hover:pointer-events-none lg:group-hover:opacity-0 lg:group-focus-within:pointer-events-none lg:group-focus-within:opacity-0">
                  <span class="font-[var(--mono)] text-[clamp(9px,1vh,11px)] tracking-[0.16em] text-[#4d9fff]">{item.period}</span>
                  <h3 class="m-0 rotate-180 font-[var(--display)] text-[clamp(0.95rem,2.2vh,1.35rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-[#e9f2fc] [writing-mode:vertical-rl]">
                    {item.title}
                  </h3>
                  <span class="font-[var(--mono)] text-[10px] text-white/25">0{i + 1}</span>
                </div>

                {/* ── Desktop: kondisi lebar (hover/focus), konten horizontal penuh ── */}
                <div class="pointer-events-none hidden h-full min-h-0 translate-y-2 flex-col opacity-0 transition-all duration-500 delay-150 ease-in-out lg:flex lg:group-hover:pointer-events-auto lg:group-hover:translate-y-0 lg:group-hover:opacity-100 lg:group-hover:delay-300 lg:group-focus-within:pointer-events-auto lg:group-focus-within:translate-y-0 lg:group-focus-within:opacity-100 lg:group-focus-within:delay-300">
                  <div class="flex shrink-0 items-center justify-between gap-3">
                    <span class="font-[var(--mono)] text-[clamp(9px,1vh,11px)] tracking-[0.16em] text-[#4d9fff]">{item.period}</span>
                    <span class="font-[var(--mono)] text-[10px] text-white/30">0{i + 1}</span>
                  </div>
                  <div class="mt-auto min-h-0 overflow-hidden pb-[clamp(2px,0.6vh,8px)]">
                    <h3 class="m-0 font-[var(--display)] text-[clamp(1.15rem,2.8vh,2rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-white [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] overflow-hidden">
                      {item.title}
                    </h3>
                    <p class="m-0 mt-[clamp(4px,0.8vh,10px)] font-[var(--mono)] text-[clamp(9px,1vh,11px)] uppercase tracking-[0.12em] text-[#82d8ed]/85 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:1] overflow-hidden">
                      {item.organization}
                    </p>
                    <p class="m-0 mt-[clamp(6px,1.1vh,14px)] max-w-[46ch] text-[clamp(0.72rem,1.2vh,0.95rem)] leading-[1.55] text-white/60 [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:3] overflow-hidden">
                      {item.detail}
                    </p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="principles section-pad flex h-auto min-h-[100svh] flex-col overflow-visible lg:h-[calc(100dvh-var(--nav-h))] lg:max-h-[calc(100dvh-var(--nav-h))] lg:min-h-0 lg:overflow-hidden" id="principles">
        <div class="section-heading shrink-0"><span class="section-number">05 — ENGINEERING NOTES</span><span class="section-aside">A FEW THINGS I BELIEVE</span></div>
