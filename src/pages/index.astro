---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SelectedWorks from '../components/sections/SelectedWorks.astro';
import Experience from '../components/sections/Experience.astro';
import { profile, capabilities } from '../data/site';
---
<BaseLayout>
  <div class="site-shell" id="top">
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <Nav />
    <main data-snap-scroll>
      <section class="hero section-pad" id="hero" aria-labelledby="hero-title">
        <div class="hero-main">
          <h1 id="hero-title" class="hero-title"><span class="title-line"><span data-split>BAYU</span></span><span class="title-line title-line-offset"><span data-split>MUTAWAKKIL</span><em class="title-period">.</em></span></h1>
          <div class="hero-bottom">
            <p class="hero-intro reveal-up">I’m <strong>Bayu Mutawakkil</strong> — an Information Systems student exploring the intersection of software engineering, business processes, and thoughtful digital experiences.</p>
            <div class="hero-actions reveal-up"><a class="button-primary magnetic" href="#work"><span>Explore projects</span><span class="button-arrow">↗</span></a><a class="text-link" href="#about">More about me <span>↓</span></a></div>
          </div>
        </div>
        <div class="hero-index"><span>01 / 05</span><span class="hero-index-line"></span><span>SCROLL TO EXPLORE</span><span class="scroll-cue">↓</span></div>
        <div class="hero-orbit" aria-hidden="true"><div class="orbit-ring ring-a"></div><div class="orbit-ring ring-b"></div><div class="orbit-core"><span>B</span></div><span class="orbit-label">IDEAS → SYSTEMS</span></div>
      </section>

      <section class="manifesto section-pad" id="about">
        <div class="section-heading"><span class="section-number">01 — THE APPROACH</span><span class="section-aside">A SYSTEMS-THINKING MINDSET</span></div>
        <div class="manifesto-grid"><h2 class="manifesto-title" data-reveal-text>Technology is not the destination. <span>It is the way we make better things possible.</span></h2><div class="manifesto-copy"><span class="eyebrow">A LITTLE CONTEXT</span><p>I study Information Systems at Universitas Andalas, where technology meets people, processes, and organizations. I’m interested in building software that does more than look good: software that solves a real problem and holds up beyond the demo.</p><p>My curiosity moves between backend logic, interface engineering, data, and enterprise systems. I enjoy understanding the whole picture before deciding what to build.</p><a class="inline-link" href="https://github.com/bayumutawakkil" target="_blank" rel="noreferrer">Explore my GitHub <span>↗</span></a></div></div>
      </section>

      <SelectedWorks />

      <section class="expertise section-pad" id="expertise">
        <div class="section-heading"><span class="section-number">03 — WHAT I BRING</span><span class="section-aside">CAPABILITIES IN PROGRESS</span></div>
        <div class="expertise-heading"><h2>Thinking in systems.<br/><span>Building with code.</span></h2><p>My work sits across disciplines. I connect technical implementation with the context and constraints around it.</p></div>
        <div class="capability-list">{capabilities.map(item=><article class="capability-row"><span class="cap-number">{item.id}</span><div class="cap-main"><h3>{item.title}</h3><p>{item.desc}</p></div><div class="cap-tags">{item.tags}</div><span class="cap-plus">↗</span></article>)}</div>
      </section>

      <Experience />

      <section class="principles section-pad" id="principles">
        <div class="section-heading"><span class="section-number">04 — ENGINEERING NOTES</span><span class="section-aside">A FEW THINGS I BELIEVE</span></div>
        <div class="principles-layout"><div class="principles-title"><span class="eyebrow">WORKING PRINCIPLES</span><h2>Good work<br/>is <span>considered.</span></h2></div><div class="principle-list"><div><span>01</span><p><strong>Understand before building.</strong> The best implementation starts with the right problem definition.</p></div><div><span>02</span><p><strong>Clarity is a feature.</strong> A system should be understandable to the people who use and maintain it.</p></div><div><span>03</span><p><strong>Details compound.</strong> Reliability, accessibility, and performance are not finishing touches.</p></div></div></div>
      </section>

      <section class="contact-section section-pad" id="contact">
        <div class="section-heading"><span class="section-number">05 — WHAT'S NEXT</span><span class="section-aside">LET'S MAKE SOMETHING MATTER</span></div>
        <div class="contact-content"><span class="eyebrow"><i class="status-dot"></i> OPEN TO COLLABORATION & OPPORTUNITIES</span><h2>Have a problem<br/>worth <span>solving?</span></h2><p>I’m always interested in thoughtful conversations, meaningful projects, and opportunities to learn through building.</p><a class="contact-cta magnetic" href={`mailto:${profile.email}`}><span>Start a conversation</span><b>↗</b></a></div>
        <div class="contact-links"><a href={profile.github} target="_blank" rel="noreferrer">GITHUB <span>↗</span></a><a href={profile.linkedin} target="_blank" rel="noreferrer">LINKEDIN <span>↗</span></a><a href={profile.instagram} target="_blank" rel="noreferrer">INSTAGRAM <span>↗</span></a><a href={`mailto:${profile.email}`}>EMAIL <span>↗</span></a></div>
      </section>
    </main>
    <Footer />
    <div class="cursor-glow" data-cursor-glow></div>
  </div>
</BaseLayout>
